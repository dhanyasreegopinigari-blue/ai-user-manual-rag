# ElectroLearn AI - Configuration Template
# Copy this file to .env and insert your API key(s)

# Preferred LLM Provider ("auto", "gemini", "openai", "claude", or "ollama")
LLM_PROVIDER=auto

# 1. Google Gemini (Recommended - Free, high rate limits, fast streaming)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI API (Optional)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Anthropic Claude API (Optional)
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 4. Local Ollama (Offline fallback)
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
